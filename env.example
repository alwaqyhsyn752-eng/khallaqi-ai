# ─── Application ───
AI_NAME=الخلاقي
DEVELOPER_NAME=حسين غلاب
VERSION=16.0.0
ENVIRONMENT=production
LOG_LEVEL=INFO
PORT=8000
WORKERS=2

# ─── Security ───
SECRET_KEY=change-me-to-a-strong-random-string
ALLOWED_ORIGINS=*

# ─── AI Providers ───
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ─── Azure TTS ───
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_VOICE_AR=ar-SA-HamedNeural

# ─── Database ───
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
# For local dev:
# DATABASE_URL=sqlite+aiosqlite:///./khallaqi.db

# ─── Redis ───
REDIS_URL=redis://localhost:6379/0

# ─── Rate Limiting ───
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_PER_HOUR=500

# ─── Observability ───
SENTRY_DSN=
OTEL_ENABLED=false
